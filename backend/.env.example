# ============================================
# PetPal - AI宠物社交平台 环境配置模板
# ============================================
# 使用说明:
# 1. 复制此文件并重命名为 .env
# 2. 根据实际环境修改配置值
# 3. 请勿将 .env 文件提交到版本控制系统
# ============================================

# -------------------- 应用配置 --------------------
# 应用名称
APP_NAME=PetPal

# 运行环境: development / staging / production
APP_ENV=development

# 调试模式: true / false (生产环境必须设为false)
DEBUG=true

# 应用密钥 (生产环境请使用随机生成的强密钥)
# 可使用命令生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production

# -------------------- 数据库配置 --------------------
# 数据库连接URL
# SQLite (开发环境): sqlite:///./petpal.db
# MySQL: mysql+pymysql://user:password@host:3306/database
# PostgreSQL: postgresql://user:password@host:5432/database
DATABASE_URL=sqlite:///./petpal.db

# 数据库连接池配置 (可选)
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# -------------------- Redis配置 --------------------
# Redis连接URL (用于缓存、验证码存储、会话管理)
REDIS_URL=redis://localhost:6379/0

# -------------------- JWT认证配置 --------------------
# JWT密钥 (生产环境必须修改，建议使用64位以上随机字符串)
# 可使用命令生成: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# JWT签名算法: HS256 / RS256
JWT_ALGORITHM=HS256

# Access Token有效期 (分钟) - 建议15-60分钟
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh Token有效期 (天) - 建议7-30天
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# -------------------- AI服务配置 --------------------
# OpenAI配置 (可选)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# 阿里云通义千问配置 (必填-用于AI诊断功能)
# 获取方式: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_VL_MODEL=qwen-vl-max
DASHSCOPE_CHAT_MODEL=qwen-max

# -------------------- 阿里云短信配置 --------------------
# 阿里云短信服务配置 (用于发送验证码)
# 获取方式: https://dysms.console.aliyun.com/
ALIYUN_SMS_ACCESS_KEY_ID=your-access-key-id
ALIYUN_SMS_ACCESS_KEY_SECRET=your-access-key-secret
ALIYUN_SMS_SIGN_NAME=PetPal
ALIYUN_SMS_TEMPLATE_CODE=SMS_123456789

# -------------------- 文件存储配置 --------------------
# 本地上传目录
UPLOAD_DIR=./uploads

# 最大上传文件大小 (字节, 默认10MB)
MAX_UPLOAD_SIZE=10485760

# 阿里云OSS配置 (生产环境推荐)
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_DOMAIN=

# -------------------- CORS跨域配置 --------------------
# 允许的前端域名列表 (JSON数组格式)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# -------------------- Celery异步任务配置 --------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# -------------------- 日志配置 --------------------
# 日志级别: DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# 日志文件路径 (可选，不设置则输出到控制台)
LOG_FILE=./logs/petpal.log

# -------------------- 监控配置 (可选) --------------------
# Sentry DSN (错误追踪)
SENTRY_DSN=

# -------------------- 支付配置 (可选) --------------------
# 支付宝配置
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# 微信支付配置
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY=
WECHAT_CERT_PATH=

# -------------------- 第三方登录配置 (可选) --------------------
# 微信登录
WECHAT_LOGIN_APP_ID=
WECHAT_LOGIN_APP_SECRET=

# 苹果登录
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
